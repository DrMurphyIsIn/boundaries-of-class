import Mathlib

/-!
# BoundariesOfClassNegControls.K1: tightness controls for the threshold route at `σ = 7/8`

Pinned environment: Lean v4.34.1, Mathlib d13f23b. Mathlib only. Never imported by the solution.

The solution's threshold engine `lt_classNumber_of_bounds_real` concludes `Hc < h(K)` from rational data `(q, r, s, e)`
with `q² ≤ X`, `(4/(πₗ X))³ ≤ r⁸`, `K̄/(7 · 1.96232) ≤ s⁶`, `(2/q)⁷ ≤ e⁸` and the final inequality `0 < F(Hc; q, r, s, e)`
below. Each control here is a kernel-checked NEGATION at a real field discriminant `d*`: for EVERY admissible data
`(q, r, s, e)` at `X = d*`, the final inequality fails at `Hc = N - 1`, so the engine cannot give `N - 1 < h(K)`, that
is `h(K) ≥ N`. The admissible set only grows with `X`, so no threshold at any `X ≤ d*` gives it either.

The controls are integer-rounded: the tampered statement, at the field `d*`, demands `h(K) > N - 1` (a value lemma
below shows its right-hand side exceeds `N - 1`), and since `h(K)` is a natural number that is exactly `h(K) ≥ N`. So
integrality cannot rescue the tamper through a weaker threshold. Whether the tampered statement is true is a separate
question, labelled COMPUTED (not proved) in the verification record. These controls certify non-derivability under the frozen bracket set
only; a route change voids them.

`hfin_false` is the general step: lower brackets `rl ≤ r`, `sl ≤ s`, `el ≤ e` (each from a pow comparison) and an upper
bracket `q ≤ qh` turn the final inequality into the rational `ZL - K̄(rl) - (Hc - 1)((6/7) K̄(rl) sl + Ē(el)) ≤ 0`, checked
by `norm_num`. `F_antitone`: `F` decreases in `Hc` over admissible data, so a negation at `Hc` holds at every larger
`Hc`. The data are generated by numerics/gen_K1.py with exact integer roots.
-/

set_option autoImplicit false

namespace BoundariesOfClassNegControls.K1

/-- The final inequality of the threshold engine, verbatim. -/
noncomputable def F (Hc q r s e : ℝ) : ℝ :=
  196232 / 100000 - 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) -
      2 * (6807 / 2500) / (10861 / 10000) * e *
        ((1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2) -
      (Hc - 1) * (6 / 7 * (6807 / 2500 * (21755 / 10000) * r * (344129 / 100000)) * s +
        2 * (6807 / 2500) / (10861 / 10000) * e *
          ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2))

/-- The admissibility conditions of the threshold engine at `X`. -/
def Admissible (X q r s e : ℝ) : Prop :=
  0 < q ∧ q ^ 2 ≤ X ∧ 0 ≤ r ∧ (4 / (3141592 / 1000000 * X)) ^ 3 ≤ r ^ 8 ∧
    0 ≤ s ∧ 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) / (7 * (196232 / 100000)) ≤ s ^ 6 ∧
    0 ≤ e ∧ (2 / q) ^ 7 ≤ e ^ 8

/-- **The general negation step.** -/
theorem hfin_false {X Hc qh rl sl el : ℝ} (_hX : 0 < X) (hHc : 1 ≤ Hc) (hqh0 : 0 < qh) (hqh : X ≤ qh ^ 2)
    (_hrl0 : 0 ≤ rl) (hrl : rl ^ 8 ≤ (4 / (3141592 / 1000000 * X)) ^ 3)
    (hsl0 : 0 ≤ sl) (hsl : sl ^ 6 ≤ 6807 / 2500 * (21755 / 10000) * rl * (344129 / 100000) / (7 * (196232 / 100000)))
    (_hel0 : 0 ≤ el) (hel : el ^ 8 ≤ (2 / qh) ^ 7)
    (hneg : 196232 / 100000 - 6807 / 2500 * (21755 / 10000) * rl * (344129 / 100000) -
      (Hc - 1) * (6 / 7 * (6807 / 2500 * (21755 / 10000) * rl * (344129 / 100000)) * sl +
        2 * (6807 / 2500) / (10861 / 10000) * el * ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2)) ≤ 0)
    {q r s e : ℝ} (hadm : Admissible X q r s e) : ¬ 0 < F Hc q r s e := by
  obtain ⟨hq0, hq, hr0, hr, hs0, hs, he0, he⟩ := hadm
  have hr' : rl ≤ r := by
    by_contra h; push Not at h
    have := pow_lt_pow_left₀ h hr0 (by norm_num : (8 : ℕ) ≠ 0)
    linarith
  have hsr : 6807 / 2500 * (21755 / 10000) * rl * (344129 / 100000) / (7 * (196232 / 100000)) ≤
      6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) / (7 * (196232 / 100000)) := by
    apply div_le_div_of_nonneg_right _ (by norm_num)
    have := mul_le_mul_of_nonneg_left hr' (by norm_num : (0 : ℝ) ≤ 6807 / 2500 * (21755 / 10000))
    nlinarith
  have hs' : sl ≤ s := by
    by_contra h; push Not at h
    have := pow_lt_pow_left₀ h hs0 (by norm_num : (6 : ℕ) ≠ 0)
    linarith
  have hqq : q ≤ qh := by
    by_contra h; push Not at h
    have := pow_lt_pow_left₀ h hqh0.le (by norm_num : (2 : ℕ) ≠ 0)
    linarith
  have h2q : 2 / qh ≤ 2 / q := div_le_div_of_nonneg_left (by norm_num) hq0 hqq
  have he' : el ≤ e := by
    by_contra h; push Not at h
    have h1 := pow_lt_pow_left₀ h he0 (by norm_num : (8 : ℕ) ≠ 0)
    have h2 : (2 / qh) ^ 7 ≤ (2 / q) ^ 7 := pow_le_pow_left₀ (by positivity) h2q 7
    linarith
  -- the principal remainder term is nonnegative
  have hy1 : 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4 < 1 := by
    rw [div_lt_one (by positivity)]
    exact one_lt_pow₀ (by nlinarith) (by norm_num)
  have hE1 : 0 ≤ 2 * (6807 / 2500) / (10861 / 10000) * e *
      ((1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2) := by
    apply mul_nonneg (by positivity) (div_nonneg (by positivity) (sq_nonneg _))
  have hkap : (0 : ℝ) ≤ (4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2 := by norm_num
  have hK : 6807 / 2500 * (21755 / 10000) * rl * (344129 / 100000) ≤
      6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) := by nlinarith
  have hKs : 6 / 7 * (6807 / 2500 * (21755 / 10000) * rl * (344129 / 100000)) * sl ≤
      6 / 7 * (6807 / 2500 * (21755 / 10000) * r * (344129 / 100000)) * s := by
    apply mul_le_mul (by linarith) hs' hsl0 (by positivity)
  have hEe : 2 * (6807 / 2500) / (10861 / 10000) * el * ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2) ≤
      2 * (6807 / 2500) / (10861 / 10000) * e * ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2) := by
    apply mul_le_mul_of_nonneg_right _ hkap
    exact mul_le_mul_of_nonneg_left he' (by norm_num)
  have hbig := mul_le_mul_of_nonneg_left (add_le_add hKs hEe) (by linarith : (0 : ℝ) ≤ Hc - 1)
  unfold F
  linarith

/-- **`F` decreases in `Hc`** over admissible data: a negation at `Hc` holds at every `Hc' ≥ Hc`. -/
theorem F_antitone {X Hc Hc' q r s e : ℝ} (hle : Hc ≤ Hc') (hadm : Admissible X q r s e) :
    F Hc' q r s e ≤ F Hc q r s e := by
  obtain ⟨-, -, hr0, -, hs0, -, he0, -⟩ := hadm
  have hc : 0 ≤ 6 / 7 * (6807 / 2500 * (21755 / 10000) * r * (344129 / 100000)) * s +
      2 * (6807 / 2500) / (10861 / 10000) * e * ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2) := by
    have : (0 : ℝ) ≤ (4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2 := by norm_num
    positivity
  unfold F
  nlinarith

