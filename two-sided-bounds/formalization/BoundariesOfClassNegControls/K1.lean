/-- (L′) with `c1′ = 3/8` at `d = 4699` demands `h > 3` (value 3.0403, COMPUTED): `log 4699 < 17/2` (`4699² < e^17`)
and `√4699 > 68`. -/
theorem value_Lprime_c : (3 : ℝ) < 3 / 8 * Real.sqrt 4699 / Real.log 4699 := by
  have he := Real.exp_one_gt_d9
  have hl2 : Real.log ((4699 : ℝ) ^ 2) < 17 := by
    rw [Real.log_lt_iff_lt_exp (by norm_num), show (17 : ℝ) = ((17 : ℕ) : ℝ) by norm_num, ← Real.exp_one_pow]
    calc ((4699 : ℝ) ^ 2) < (2.7182818283 : ℝ) ^ 17 := by norm_num
      _ ≤ Real.exp 1 ^ 17 := pow_le_pow_left₀ (by norm_num) he.le 17
  rw [Real.log_pow] at hl2
  have hl0 : 0 < Real.log (4699 : ℝ) := Real.log_pos (by norm_num)
  have hs : (68 : ℝ) < Real.sqrt 4699 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  rw [lt_div_iff₀ hl0]
  push_cast at hl2
  linarith

