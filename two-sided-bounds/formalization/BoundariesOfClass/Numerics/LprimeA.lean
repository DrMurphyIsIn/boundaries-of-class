import BoundariesOfClass.Numerics.SevenEighths

/-!
# BoundariesOfClass.Numerics.LprimeA: the uniform lower bound `(1/3) √d / log d ≤ h` for `log d ∈ [8, 16]`

Pinned environment: Lean v4.34.1, Mathlib d13f23b. At `σ = 7/8`, by eighteen intervals `u = log d ∈ [u_i, u_{i+1}]`
(endpoints in `(1/64)ℤ`, generated by numerics/gen_Lprime_A.py): on each, `d ≥ e^{u_i} ≥ X_i` gives `h > H_i` by the
real-valued threshold theorem `lt_classNumber_of_bounds_real`, and `(1/3)√d/log d ≤ e^{u_{i+1}/2}/(3 u_i) ≤ H_i`.

* `exp_nat_add_div_ge`, `exp_nat_add_div_le`: rational brackets for `e^{a + b/64}`, from
  `e ∈ (2.7182818283, 2.7182818286)`, `e^{1/64} ≥ 1 + 1/64 + 1/8192` and `e^{1/64} ≤ 1.015747709`.
* `third_sqrt_div_log_le_of_interval`: one interval.
* `third_sqrt_div_log_le_A`: `8 ≤ log d ≤ 16 ⇒ (1/3)√d/log d ≤ h(K)`.
-/

set_option autoImplicit false

open NumberField CN1.Finite

namespace BoundariesOfClass.Numerics

lemma exp_nat_add_div_ge (a b : ℕ) :
    (27182818283 / 10000000000 : ℝ) ^ a * (1 + 1 / 64 + 1 / 8192) ^ b ≤ Real.exp ((a : ℝ) + b / 64) := by
  rw [Real.exp_add, ← Real.exp_one_pow, show (b : ℝ) / 64 = b * (1 / 64) by ring, Real.exp_nat_mul]
  have he : (27182818283 / 10000000000 : ℝ) ≤ Real.exp 1 := by
    have := Real.exp_one_gt_d9; norm_num at this ⊢; linarith
  have h64 : (1 + 1 / 64 + 1 / 8192 : ℝ) ≤ Real.exp (1 / 64) := by
    have := Real.quadratic_le_exp_of_nonneg (x := 1 / 64) (by norm_num); norm_num at this ⊢; linarith
  exact mul_le_mul (pow_le_pow_left₀ (by norm_num) he a) (pow_le_pow_left₀ (by norm_num) h64 b)
    (by positivity) (by positivity)

lemma exp_one_div_64_le : Real.exp (1 / 64) ≤ (1015747709 / 1000000000 : ℝ) := by
  have h : Real.exp (1 / 64) ^ 64 = Real.exp 1 := by rw [← Real.exp_nat_mul]; norm_num
  have he := Real.exp_one_lt_d9
  have h2 : Real.exp (1 / 64) ^ 64 ≤ (1015747709 / 1000000000 : ℝ) ^ 64 := by
    rw [h]; norm_num at he ⊢; linarith
  exact (pow_le_pow_iff_left₀ (Real.exp_pos _).le (by norm_num) (by norm_num)).mp h2

lemma exp_nat_add_div_le (a b : ℕ) :
    Real.exp ((a : ℝ) + b / 64) ≤ (27182818286 / 10000000000 : ℝ) ^ a * (1015747709 / 1000000000) ^ b := by
  rw [Real.exp_add, ← Real.exp_one_pow, show (b : ℝ) / 64 = b * (1 / 64) by ring, Real.exp_nat_mul]
  have he : Real.exp 1 ≤ (27182818286 / 10000000000 : ℝ) := by
    have := Real.exp_one_lt_d9; norm_num at this ⊢; linarith
  exact mul_le_mul (pow_le_pow_left₀ (Real.exp_pos _).le he a)
    (pow_le_pow_left₀ (Real.exp_pos _).le exp_one_div_64_le b) (by positivity) (by positivity)

/-- **One interval.** -/
theorem third_sqrt_div_log_le_of_interval {K : Type*} [Field K] [NumberField K] {m : ℕ} {α : K}
    (hα : α ^ 2 = -(m : K)) (hK : Module.finrank ℚ K = 2) (hm : Squarefree m) (hm1 : m ≠ 1) (hm3 : m ≠ 3)
    {ua ub X Y Hc q r s e : ℝ} (hua0 : 0 < ua) (hlo : ua ≤ Real.log (dOf m)) (hhi : Real.log (dOf m) ≤ ub)
    (hXe : X ≤ Real.exp ua) (hYe : Real.exp (ub / 2) ≤ Y) (hneed : Y / (3 * ua) ≤ Hc) (hHc : 1 ≤ Hc) (hX : 0 < X)
    (hq0 : 0 < q) (hq : q ^ 2 ≤ X) (hr0 : 0 ≤ r) (hr : (4 / (3141592 / 1000000 * X)) ^ 3 ≤ r ^ 8)
    (hs0 : 0 ≤ s) (hs : 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) / (7 * (196232 / 100000)) ≤ s ^ 6)
    (he0 : 0 ≤ e) (he : (2 / q) ^ 7 ≤ e ^ 8)
    (hfin : 0 < 196232 / 100000 - 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) -
      2 * (6807 / 2500) / (10861 / 10000) * e *
        ((1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2) -
      (Hc - 1) * (6 / 7 * (6807 / 2500 * (21755 / 10000) * r * (344129 / 100000)) * s +
        2 * (6807 / 2500) / (10861 / 10000) * e *
          ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2))) :
    1 / 3 * Real.sqrt (dOf m) / Real.log (dOf m) ≤ (classNumber K : ℝ) := by
  have hD0 : (0 : ℝ) < (dOf m : ℝ) := BoundariesOfClass.Assembly.dOf_pos hm
  have hd : X ≤ (dOf m : ℝ) := by
    refine hXe.trans ?_
    rw [← Real.exp_log hD0]; exact Real.exp_le_exp.mpr hlo
  have hH := lt_classNumber_of_bounds_real hα hK hm hm1 hm3 Hc hHc hX hd hq0 hq hr0 hr hs0 hs he0 he hfin
  have hlog0 : 0 < Real.log (dOf m) := lt_of_lt_of_le hua0 hlo
  have hsq : Real.sqrt (dOf m) ≤ Y := by
    rw [← Real.exp_log hD0, ← Real.exp_half]
    exact (Real.exp_le_exp.mpr (by linarith)).trans hYe
  have h1 : 1 / 3 * Real.sqrt (dOf m) / Real.log (dOf m) ≤ Y / (3 * ua) := by
    rw [div_le_div_iff₀ hlog0 (by positivity)]
    have := Real.sqrt_nonneg (dOf m : ℝ)
    nlinarith
  linarith

