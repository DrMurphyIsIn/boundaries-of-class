    (hα : α ^ 2 = -(m : K)) (hK : Module.finrank ℚ K = 2) (hm : Squarefree m) (hm1 : m ≠ 1) (hm3 : m ≠ 3)
    (hlo : (8 : ℝ) + 0 / 64 ≤ Real.log (dOf m)) (hhi : Real.log (dOf m) ≤ 2 * ((4 : ℝ) + 2 / 64)) :
    1 / 3 * Real.sqrt (dOf m) / Real.log (dOf m) ≤ (classNumber K : ℝ) := by
  have hX := exp_nat_add_div_ge 8 0
  have hY := exp_nat_add_div_le 4 2
  push_cast at hX hY
  refine third_sqrt_div_log_le_of_interval hα hK hm hm1 hm3 (ua := (8 : ℝ) + 0 / 64)
    (ub := 2 * ((4 : ℝ) + 2 / 64)) (X := (2980957 / 1000 : ℝ)) (Y := (27182818286 / 10000000000 : ℝ) ^ 4 *
      (1015747709 / 1000000000) ^ 2) (Hc := (1176773 / 500000 : ℝ)) (q := (545981 / 10000 : ℝ)) (r := (5450771 / 100000000 : ℝ)) (s := (65762911 / 100000000 : ℝ)) (e := (5538229 / 100000000 : ℝ))
    (by norm_num) hlo hhi (le_trans (by norm_num) hX) (by rw [mul_div_cancel_left₀ _ two_ne_zero]; exact hY)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)

