import BoundariesOfClass.Numerics.SevenEighths

/-!
# BoundariesOfClass.Numerics.Thresholds: the class number thresholds, one theorem each

Pinned environment: Lean v4.34.1, Mathlib d13f23b. Each theorem instantiates `lt_classNumber_of_bounds` (the class sum
at `σ = 7/8` with every class charged its exact floor and the `K_{1/2}` remainder) with rational data `(q, r, s, e)`
generated by numerics/gen_T_instances.py; every numerical hypothesis is checked here by `norm_num`.

* `lt_classNumber_of_le_dOf_<N>`: `X ≤ d ⇒ N < h(K)`, for the thresholds `h ≤ N ⇒ d < X`;
* the three point values (`d ≥ X ⇒ h ≥ N`) are the same theorem with `N - 1`.
-/

set_option autoImplicit false

open NumberField CN1.Finite

namespace BoundariesOfClass.Numerics

theorem lt_classNumber_of_le_dOf_le_one {K : Type*} [Field K] [NumberField K] {m : ℕ} {α : K}
    (hα : α ^ 2 = -(m : K)) (hK : Module.finrank ℚ K = 2) (hm : Squarefree m) (hm1 : m ≠ 1) (hm3 : m ≠ 3)
    (hd : (660 : ℝ) ≤ (dOf m : ℝ)) : 1 < classNumber K :=
  lt_classNumber_of_bounds hα hK hm hm1 hm3 1 (by norm_num) (X := 660) (q := (32113 / 1250 : ℝ)) (r := (239857 / 2500000 : ℝ)) (s := (72261467 / 100000000 : ℝ))
    (e := (669471 / 6250000 : ℝ)) (by norm_num) hd (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)

