import BoundariesOfClass.Assembly.FloorSum
import CN1.Numerics.GammaBounds
import CN1.Numerics.GammaRatio
import CN1.Numerics.ZetaValues
import HCN.Numerics.Threshold

/-!
# BoundariesOfClass.Numerics.SevenEighths: the class number thresholds at `σ = 7/8`

Pinned environment: Lean v4.34.1, Mathlib d13f23b. At `σ = 7/8` every constant of `classSum_floor_half` (the class sum
with every class charged its exact floor, `K_{1/2}` remainder) has a rational bracket already proved in CN-1 or HCN:
`ζ(7/4) ≥ 1.96232`, `ζ(3/4) ≥ -3.44129`, `Γ(3/8)/Γ(7/8) ≤ 2.1755`, `π^{7/8} ≤ 6807/2500`, `e^{-3π/4} ≤ 4767/50000`; plus
`Γ(7/8) ≥ 1.0861` (Bohr–Mollerup with `n = 16`, `gamma_seven_eighths_ge`). With `δ = 1/8` the floor exponent is
`δ/(1 - 2δ) = 1/6` and `1 - δ/σ = 6/7`.

* `lt_classNumber_of_bounds`: if `X ≤ d` and the rational data `(q, r, s, e)` satisfy
  `q² ≤ X`, `(4/(πₗ X))³ ≤ r⁸`, `K̄/(7 · 1.96232) ≤ s⁶` (`K̄ = (6807/2500)(2.1755) r (3.44129)`), `(2/q)⁷ ≤ e⁸`, and the
  final rational inequality `1.96232 - K̄ - Ē₁ - (N - 1)((6/7) K̄ s + Ē) > 0`, then `N < h(K)`.
  Monotonicity in `d` is built in: every bound is taken at `X ≤ d`.

The instances (one per threshold) are generated by numerics/gen_T_instances.py and checked again here by `norm_num`.
-/

set_option autoImplicit false

open NumberField Complex CN1.Finite HCN.CS BoundariesOfClass.CS BoundariesOfClass.Analytic
open scoped Real

namespace BoundariesOfClass.Numerics

/-- **`Γ(7/8) ≥ 1.0861`** (true value `1.0896…`): Bohr–Mollerup at `n = 16`,
`Γ(7/8) ≥ 16! (16 + 7/8)^{-1/8} / ∏_{k<16} (7/8 + k)`. -/
theorem gamma_seven_eighths_ge : (10861 / 10000 : ℝ) ≤ Real.Gamma (7 / 8) := by
  have hx : (0 : ℝ) < 7 / 8 := by norm_num
  have hge := CN1.Numerics.Gamma_add_ge 16 hx (by norm_num)
  rw [CN1.Numerics.Gamma_add_nat_eq hx 16] at hge
  have h17 : Real.Gamma ((16 : ℕ) + 1 : ℝ) = (Nat.factorial 16 : ℝ) := by
    rw [show ((16 : ℕ) : ℝ) + 1 = ((16 : ℕ) : ℝ) + 1 by rfl, Real.Gamma_nat_eq_factorial]
  rw [h17] at hge
  -- `(16 + 7/8)^{-1/8} ≥ 1/U`
  have hU : ((16 : ℕ) + 7 / 8 : ℝ) ^ (1 / 8 : ℝ) ≤ 711829 / 500000 :=
    HCN.Numerics.rpow_le_of_pow_le (k := 1) (n := 8) (by positivity) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num)
  have hpos : 0 < ((16 : ℕ) + 7 / 8 : ℝ) ^ (1 / 8 : ℝ) := Real.rpow_pos_of_pos (by positivity) _
  have hneg : ((16 : ℕ) + 7 / 8 : ℝ) ^ ((7 / 8 : ℝ) - 1) = (((16 : ℕ) + 7 / 8 : ℝ) ^ (1 / 8 : ℝ))⁻¹ := by
    rw [show (7 / 8 : ℝ) - 1 = -(1 / 8) by norm_num, Real.rpow_neg (by positivity)]
  rw [hneg] at hge
  have hprod : ∏ k ∈ Finset.range 16, ((7 / 8 : ℝ) + k) =
      (7 / 8) * (15 / 8) * (23 / 8) * (31 / 8) * (39 / 8) * (47 / 8) * (55 / 8) * (63 / 8) * (71 / 8) * (79 / 8) *
        (87 / 8) * (95 / 8) * (103 / 8) * (111 / 8) * (119 / 8) * (127 / 8) := by
    simp only [Finset.prod_range_succ, Finset.prod_range_zero]; norm_num
  rw [hprod] at hge
  have hinv : (500000 / 711829 : ℝ) ≤ (((16 : ℕ) + 7 / 8 : ℝ) ^ (1 / 8 : ℝ))⁻¹ := by
    rw [show (500000 / 711829 : ℝ) = (711829 / 500000)⁻¹ by norm_num]
    exact inv_anti₀ hpos hU
  have hfact : (Nat.factorial 16 : ℝ) = 20922789888000 := by norm_num [Nat.factorial]
  rw [hfact] at hge
  have hP : (0 : ℝ) < (7 / 8) * (15 / 8) * (23 / 8) * (31 / 8) * (39 / 8) * (47 / 8) * (55 / 8) * (63 / 8) *
      (71 / 8) * (79 / 8) * (87 / 8) * (95 / 8) * (103 / 8) * (111 / 8) * (119 / 8) * (127 / 8) := by norm_num
  have h2 := mul_le_mul_of_nonneg_left hinv (by norm_num : (0 : ℝ) ≤ 20922789888000)
  have h3 := h2.trans hge
  have h4 : 20922789888000 * (500000 / 711829 : ℝ) /
      ((7 / 8) * (15 / 8) * (23 / 8) * (31 / 8) * (39 / 8) * (47 / 8) * (55 / 8) * (63 / 8) * (71 / 8) *
        (79 / 8) * (87 / 8) * (95 / 8) * (103 / 8) * (111 / 8) * (119 / 8) * (127 / 8)) ≤ Real.Gamma (7 / 8) := by
    rw [div_le_iff₀ hP]; linarith [h3]
  refine le_trans ?_ h4
  norm_num

/-- `e^{-x} ≤ (1 + x/4)^{-4}` for `x ≥ 0`. -/
lemma exp_neg_le_pow (x : ℝ) (hx : 0 ≤ x) : Real.exp (-x) ≤ 1 / (1 + x / 4) ^ 4 := by
  have h1 : 1 + x / 4 ≤ Real.exp (x / 4) := by linarith [Real.add_one_le_exp (x / 4)]
  have h2 : (1 + x / 4) ^ 4 ≤ Real.exp x := by
    calc (1 + x / 4) ^ 4 ≤ Real.exp (x / 4) ^ 4 := pow_le_pow_left₀ (by positivity) h1 4
      _ = Real.exp x := by rw [← Real.exp_nat_mul]; ring_nf
  rw [Real.exp_neg, le_div_iff₀ (by positivity)]
  calc (Real.exp x)⁻¹ * (1 + x / 4) ^ 4 ≤ (Real.exp x)⁻¹ * Real.exp x :=
        mul_le_mul_of_nonneg_left h2 (by positivity)
    _ = 1 := inv_mul_cancel₀ (Real.exp_pos x).ne'

/-- The rational upper bracket for `κ(3π/2)`: `e^{-3π/2} = (e^{-3π/4})² ≤ (4767/50000)²`. -/
lemma kappa_three_pi_div_two_le :
    kappa (3 * π / 2) ≤ (4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2 := by
  have h := HCN.Numerics.exp_neg_three_pi_div_four_le
  have he : Real.exp (-(3 * π / 2)) = Real.exp (-(3 * π / 4)) ^ 2 := by
    rw [← Real.exp_nat_mul]; ring_nf
  have h2 : Real.exp (-(3 * π / 2)) ≤ (4767 / 50000 : ℝ) ^ 2 := by
    rw [he]; exact pow_le_pow_left₀ (Real.exp_pos _).le h 2
  unfold kappa
  exact div_one_sub_sq_mono (Real.exp_pos _).le h2 (by norm_num)

/-- The last step, in pure real arithmetic. -/
lemma final_step {N h P0 F E2 Fb Eb Pb : ℝ} (hcore : P0 - (h - 1) * (F + E2) ≤ 0) (hN1 : 0 ≤ N - 1)
    (hh : h ≤ N) (hF0 : 0 ≤ F) (hE0 : 0 ≤ E2) (hFb : F ≤ Fb) (hEb : E2 ≤ Eb) (hP : Pb ≤ P0)
    (hfin : 0 < Pb - (N - 1) * (Fb + Eb)) : False := by
  have h1 : (h - 1) * (F + E2) ≤ (N - 1) * (F + E2) := mul_le_mul_of_nonneg_right (by linarith) (by linarith)
  have h2 : (N - 1) * (F + E2) ≤ (N - 1) * (Fb + Eb) := mul_le_mul_of_nonneg_left (by linarith) hN1
  linarith

set_option maxHeartbeats 1600000 in
/-- **The threshold theorem at `σ = 7/8`, with rational data**, real-valued: `Hc < h(K)`. -/
theorem lt_classNumber_of_bounds_real {K : Type*} [Field K] [NumberField K] {m : ℕ} {α : K} (hα : α ^ 2 = -(m : K))
    (hK : Module.finrank ℚ K = 2) (hm : Squarefree m) (hm1 : m ≠ 1) (hm3 : m ≠ 3)
    (Hc : ℝ) (hHc : 1 ≤ Hc) {X q r s e : ℝ} (hX : 0 < X) (hd : X ≤ (dOf m : ℝ))
    (hq0 : 0 < q) (hq : q ^ 2 ≤ X) (hr0 : 0 ≤ r) (hr : (4 / (3141592 / 1000000 * X)) ^ 3 ≤ r ^ 8)
    (hs0 : 0 ≤ s) (hs : 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) / (7 * (196232 / 100000)) ≤ s ^ 6)
    (he0 : 0 ≤ e) (he : (2 / q) ^ 7 ≤ e ^ 8)
    (hfin : 0 < 196232 / 100000 - 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) -
      2 * (6807 / 2500) / (10861 / 10000) * e *
        ((1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2) -
      (Hc - 1) * (6 / 7 * (6807 / 2500 * (21755 / 10000) * r * (344129 / 100000)) * s +
        2 * (6807 / 2500) / (10861 / 10000) * e *
          ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2))) :
    Hc < (classNumber K : ℝ) := by
  have hcore := BoundariesOfClass.Assembly.classSum_floor_half hα hK hm hm1 hm3 (σ := 7 / 8) le_rfl (by norm_num)
  set D : ℝ := (dOf m : ℝ) with hDdef
  have hD0 : 0 < D := lt_of_lt_of_le hX hd
  -- the exponents at `σ = 7/8`
  rw [show (2 * (7 / 8 : ℝ) - 1 : ℝ) = 3 / 4 by norm_num, show (2 * (7 / 8 : ℝ) : ℝ) = 7 / 4 by norm_num,
    show (1 - (1 - (7 / 8 : ℝ)) / (7 / 8)) = 6 / 7 by norm_num,
    show (1 - (7 / 8 : ℝ)) / (1 - 2 * (1 - 7 / 8)) = 1 / 6 by norm_num] at hcore
  -- the ζ brackets
  obtain ⟨z74, hz74, hz74lo, -⟩ := CN1.Numerics.riemannZeta_seven_quarters
  obtain ⟨z34, hz34, hz34lo, hz34hi⟩ := CN1.Numerics.riemannZeta_three_quarters
  rw [show (((7 / 4 : ℝ) : ℝ) : ℂ) = (7 / 4 : ℂ) by push_cast; ring, hz74, Complex.ofReal_re,
    show (((3 / 4 : ℝ) : ℝ) : ℂ) = (3 / 4 : ℂ) by push_cast; ring, hz34, Complex.ofReal_re] at hcore
  -- the coefficient `C₁ = coeffR 1 D (7/8)`
  set C1 := coeffR 1 D (7 / 8) with hC1def
  have hC1pos : 0 < C1 := coeffR_pos one_pos hD0 (by norm_num)
  have hC1le : C1 ≤ 6807 / 2500 * (21755 / 10000) * r := by
    rw [hC1def]; unfold coeffR
    rw [Real.sqrt_one, inv_one, mul_one, show (7 / 8 : ℝ) - 1 / 2 = 3 / 8 by norm_num]
    have hπ := HCN.Numerics.pi_rpow_78_le
    obtain ⟨-, hG⟩ := CN1.Numerics.Gamma_ratio_enclosure
    have hpow : (4 * 1 / (π * D)) ^ (3 / 8 : ℝ) ≤ r := by
      have h1 : 4 * 1 / (π * D) ≤ 4 / (3141592 / 1000000 * X) := by
        rw [mul_one]
        apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
        have := Real.pi_gt_d6
        nlinarith
      have h2 : (4 * 1 / (π * D)) ^ (3 / 8 : ℝ) ≤ (4 / (3141592 / 1000000 * X)) ^ (3 / 8 : ℝ) :=
        Real.rpow_le_rpow (by positivity) h1 (by norm_num)
      exact h2.trans (HCN.Numerics.rpow_le_of_pow_le (k := 3) (n := 8) (by positivity) hr0 (by norm_num)
        (by norm_num) hr)
    have hG0 : 0 ≤ Real.Gamma (3 / 8) / Real.Gamma (7 / 8) :=
      div_nonneg (Real.Gamma_pos_of_pos (by norm_num)).le (Real.Gamma_pos_of_pos (by norm_num)).le
    have hπ0 : 0 ≤ π ^ (7 / 8 : ℝ) := by positivity
    calc π ^ (7 / 8 : ℝ) * Real.Gamma (3 / 8) / Real.Gamma (7 / 8) * (4 * 1 / (π * D)) ^ (3 / 8 : ℝ)
        = π ^ (7 / 8 : ℝ) * (Real.Gamma (3 / 8) / Real.Gamma (7 / 8)) * (4 * 1 / (π * D)) ^ (3 / 8 : ℝ) := by ring
      _ ≤ 6807 / 2500 * (21755 / 10000) * r := by
          apply mul_le_mul (mul_le_mul hπ (by linarith) hG0 (by norm_num)) hpow (by positivity) (by positivity)
  set Kb := 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000 : ℝ) with hKb
  have hK : C1 * -z34 ≤ Kb := by
    rw [hKb]; exact mul_le_mul hC1le (by linarith) (by linarith) (by positivity)
  have hK0 : 0 ≤ C1 * -z34 := mul_nonneg hC1pos.le (by linarith)
  -- the floor's sixth root
  have hsix : (1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74) ≤ Kb / (7 * (196232 / 100000)) := by
    rw [show (1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74) = C1 * -z34 / (7 * z74) by field_simp; ring]
    exact div_le_div₀ (by positivity) hK (by norm_num) (by linarith)
  have hroot : ((1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74)) ^ (1 / 6 : ℝ) ≤ s := by
    have h0 : 0 ≤ (1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74) := by
      apply div_nonneg (by nlinarith) (by nlinarith)
    refine (Real.rpow_le_rpow h0 hsix (by norm_num)).trans ?_
    exact HCN.Numerics.rpow_le_of_pow_le (k := 1) (n := 6) (by positivity) hs0 (by norm_num) (by norm_num)
      (by simpa using hs)
  -- the remainder constants
  have hsD : 0 < Real.sqrt D := Real.sqrt_pos.mpr hD0
  have hqD : q ≤ Real.sqrt D := by
    rw [Real.le_sqrt hq0.le hD0.le]; linarith
  have hEpref : 2 * π ^ (7 / 8 : ℝ) / Real.Gamma (7 / 8) * (2 / Real.sqrt D) ^ (7 / 8 : ℝ) ≤
      2 * (6807 / 2500) / (10861 / 10000) * e := by
    have hπ := HCN.Numerics.pi_rpow_78_le
    have hG := gamma_seven_eighths_ge
    have hGp : 0 < Real.Gamma (7 / 8) := Real.Gamma_pos_of_pos (by norm_num)
    have hp : (2 / Real.sqrt D) ^ (7 / 8 : ℝ) ≤ e := by
      have h1 : 2 / Real.sqrt D ≤ 2 / q := div_le_div_of_nonneg_left (by norm_num) hq0 hqD
      refine (Real.rpow_le_rpow (by positivity) h1 (by norm_num)).trans ?_
      exact HCN.Numerics.rpow_le_of_pow_le (k := 7) (n := 8) (by positivity) he0 (by norm_num) (by norm_num) he
    have h1 : 2 * π ^ (7 / 8 : ℝ) / Real.Gamma (7 / 8) ≤ 2 * (6807 / 2500) / (10861 / 10000) :=
      div_le_div₀ (by norm_num) (by linarith [hπ]) (by norm_num) hG
    exact mul_le_mul h1 hp (by positivity) (by positivity)
  have hk32 := kappa_three_pi_div_two_le
  have hk1 : kappa (π * Real.sqrt D) ≤
      (1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2 := by
    have hx : 3141592 / 1000000 * q ≤ π * Real.sqrt D := by
      have hp : (3141592 / 1000000 : ℝ) ≤ π := by have := Real.pi_gt_d6; norm_num at this; linarith
      exact mul_le_mul hp hqD hq0.le Real.pi_pos.le
    have he1 : Real.exp (-(π * Real.sqrt D)) ≤ 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4 :=
      (exp_neg_le_pow _ (by positivity)).trans
        (one_div_le_one_div_of_le (by positivity) (pow_le_pow_left₀ (by positivity) (by linarith) 4))
    have hlt : 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4 < 1 := by
      rw [div_lt_one (by positivity)]
      have : 1 < 1 + 3141592 / 1000000 * q / 4 := by linarith
      exact one_lt_pow₀ this (by norm_num)
    unfold kappa
    exact div_one_sub_sq_mono (Real.exp_pos _).le he1 hlt
  have hkap0 := kappa_nonneg (π * Real.sqrt D)
  have hkap0' := kappa_nonneg (3 * π / 2)
  have hpref0 : 0 ≤ 2 * π ^ (7 / 8 : ℝ) / Real.Gamma (7 / 8) * (2 / Real.sqrt D) ^ (7 / 8 : ℝ) := by
    have := Real.Gamma_pos_of_pos (show (0 : ℝ) < 7 / 8 by norm_num); positivity
  -- conclude
  by_contra hle
  push Not at hle
  have hhN : ((classNumber K : ℕ) : ℝ) ≤ Hc := hle
  have hN1 : (0 : ℝ) ≤ Hc - 1 := by linarith
  have hroot0 : 0 ≤ ((1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74)) ^ (1 / 6 : ℝ) := Real.rpow_nonneg (by
    apply div_nonneg (by nlinarith) (by nlinarith)) _
  have hF0 : 0 ≤ 6 / 7 * (C1 * -z34) * ((1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74)) ^ (1 / 6 : ℝ) :=
    mul_nonneg (by positivity) hroot0
  have hFle : 6 / 7 * (C1 * -z34) * ((1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74)) ^ (1 / 6 : ℝ) ≤
      6 / 7 * Kb * s := by
    have := mul_le_mul hK hroot hroot0 (by positivity)
    have e1 : 6 / 7 * (C1 * -z34) * ((1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74)) ^ (1 / 6 : ℝ) =
        6 / 7 * ((C1 * -z34) * ((1 - 7 / 8 : ℝ) * (C1 * -z34) / (7 / 8 * z74)) ^ (1 / 6 : ℝ)) := by ring
    rw [e1]; linarith
  have hE2le := mul_le_mul hEpref hk32 hkap0' (by positivity)
  have hE1le := mul_le_mul hEpref hk1 hkap0 (by positivity)
  have hE20 : 0 ≤ 2 * π ^ (7 / 8 : ℝ) / Real.Gamma (7 / 8) * (2 / Real.sqrt D) ^ (7 / 8 : ℝ) * kappa (3 * π / 2) :=
    mul_nonneg hpref0 hkap0'
  have hP : 196232 / 100000 - Kb - 2 * (6807 / 2500) / (10861 / 10000) * e *
      ((1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2) ≤
      z74 + C1 * z34 - 2 * π ^ (7 / 8 : ℝ) / Real.Gamma (7 / 8) * (2 / Real.sqrt D) ^ (7 / 8 : ℝ) *
        kappa (π * Real.sqrt D) := by
    have : C1 * z34 = -(C1 * -z34) := by ring
    linarith [hK, hE1le, hz74lo]
  exact final_step hcore hN1 hhN hF0 hE20 hFle hE2le hP hfin

/-- **The threshold theorem at `σ = 7/8`, with rational data.** -/
theorem lt_classNumber_of_bounds {K : Type*} [Field K] [NumberField K] {m : ℕ} {α : K} (hα : α ^ 2 = -(m : K))
    (hK : Module.finrank ℚ K = 2) (hm : Squarefree m) (hm1 : m ≠ 1) (hm3 : m ≠ 3)
    (N : ℕ) (hN : 1 ≤ N) {X q r s e : ℝ} (hX : 0 < X) (hd : X ≤ (dOf m : ℝ))
    (hq0 : 0 < q) (hq : q ^ 2 ≤ X) (hr0 : 0 ≤ r) (hr : (4 / (3141592 / 1000000 * X)) ^ 3 ≤ r ^ 8)
    (hs0 : 0 ≤ s) (hs : 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) / (7 * (196232 / 100000)) ≤ s ^ 6)
    (he0 : 0 ≤ e) (he : (2 / q) ^ 7 ≤ e ^ 8)
    (hfin : 0 < 196232 / 100000 - 6807 / 2500 * (21755 / 10000) * r * (344129 / 100000) -
      2 * (6807 / 2500) / (10861 / 10000) * e *
        ((1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) / (1 - 1 / (1 + 3141592 / 1000000 * q / 4) ^ 4) ^ 2) -
      ((N : ℝ) - 1) * (6 / 7 * (6807 / 2500 * (21755 / 10000) * r * (344129 / 100000)) * s +
        2 * (6807 / 2500) / (10861 / 10000) * e *
          ((4767 / 50000 : ℝ) ^ 2 / (1 - (4767 / 50000 : ℝ) ^ 2) ^ 2))) :
    N < classNumber K := by
  have h := lt_classNumber_of_bounds_real hα hK hm hm1 hm3 (N : ℝ) (Nat.one_le_cast.mpr hN) hX hd hq0 hq hr0 hr
    hs0 hs he0 he hfin
  exact_mod_cast h

end BoundariesOfClass.Numerics
